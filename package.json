{
  "name": "@richardmcquiston01/storage-adapters",
  "version": "0.1.0",
  "description": "Tiny, runtime-neutral storage adapter layer for TypeScript: an async key-value contract with typed errors and revisions, composable wrappers (prefix, fallback, retry, cache, encoding), and a generic persistence helper with conflict handling. No I/O in the core.",
  "keywords": [
    "typescript",
    "storage",
    "adapter",
    "localstorage",
    "indexeddb",
    "persistence",
    "key-value",
    "conflict-resolution",
    "esm",
    "commonjs"
  ],
  "license": "Apache-2.0",
  "author": "Richard McQuiston (https://richardmcquiston.com/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/storage-adapters.git"
  },
  "homepage": "https://github.com/RichardMcQuiston01/storage-adapters#readme",
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/storage-adapters/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "bun test test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
